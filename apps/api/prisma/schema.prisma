generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ──────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  COORDINATOR
  PANEL_CHAIR
  JUDGE
  TEAM_REP
  AUDITOR
}

enum EventRole {
  ADMIN
  COORDINATOR
  PANEL_CHAIR
  AUDITOR
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String   @default("")
  phone        String?
  role         Role
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  auditLogs           AuditLog[]
  conflictsDeclaredBy ConflictDeclaration[] @relation("declared_by")
  conflictsResolvedBy ConflictDeclaration[] @relation("resolved_by")

  eventUsers    EventUser[]
  daysClosed    JudgingDay[]   @relation("day_closed_by")
  daysLocked    JudgingDay[]   @relation("day_panels_locked_by")
  linksIssued   JudgeLink[]    @relation("link_created_by")
  decisionsMade TeamDecision[] @relation("decided_by")

  @@map("users")
}

// ─── Event ─────────────────────────────────────────────

enum EventStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

model Event {
  id                          String         @id @default(uuid()) @db.Uuid
  name                        String
  description                 String?
  location                    String?
  timezone                    String         @default("UTC")
  startDate                   DateTime       @map("start_date") @db.Date
  endDate                     DateTime       @map("end_date") @db.Date
  judgingStart                DateTime?      @map("judging_start") @db.Date
  judgingEnd                  DateTime?      @map("judging_end") @db.Date
  sessionDurationMinutes      Int            @default(20) @map("session_duration_minutes")
  presentationDurationMinutes Int            @default(10) @map("presentation_duration_minutes")
  qaDurationMinutes           Int            @default(5) @map("qa_duration_minutes")
  scoringDurationMinutes      Int            @default(3) @map("scoring_duration_minutes")
  transitionBufferMinutes     Int            @default(2) @map("transition_buffer_minutes")
  minJudgesPerTeam            Int            @default(3) @map("min_judges_per_team")
  maxJudgesPerTeam            Int            @default(5) @map("max_judges_per_team")
  status                      EventStatus    @default(DRAFT)
  /// How the event was set up. UPLOAD events come from the Excel workbook and
  /// use day links, per-team decisions and day closure; WIZARD events keep the
  /// original flow.
  setupMode                   EventSetupMode @default(WIZARD) @map("setup_mode")
  /// Closing the event (status COMPLETED) is final: everything is read-only.
  closedAt                    DateTime?      @map("closed_at")
  closedById                  String?        @map("closed_by") @db.Uuid
  createdAt                   DateTime       @default(now()) @map("created_at")
  updatedAt                   DateTime       @updatedAt @map("updated_at")
  deletedAt                   DateTime?      @map("deleted_at")

  tracks           ChallengeTrack[]
  rooms            Room[]
  timeSlots        TimeSlot[]
  teams            Team[]
  rounds           JudgingRound[]
  judges           Judge[]
  scoringTemplates ScoringTemplate[]
  conflicts        ConflictDeclaration[]
  auditLogs        AuditLog[]
  rankings         RankingResult[]
  sessions         JudgingSession[]

  eventUsers    EventUser[]
  judgingDays   JudgingDay[]
  judgeLinks    JudgeLink[]
  teamDecisions TeamDecision[]

  @@map("events")
}

// ─── Challenge Track ───────────────────────────────────

enum TrackStatus {
  ACTIVE
  ARCHIVED
}

model ChallengeTrack {
  id           String      @id @default(uuid()) @db.Uuid
  eventId      String      @map("event_id") @db.Uuid
  name         String
  description  String?
  displayOrder Int         @default(0) @map("display_order")
  status       TrackStatus @default(ACTIVE)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  deletedAt    DateTime?   @map("deleted_at")

  event          Event            @relation(fields: [eventId], references: [id])
  teams          Team[]
  judgeExpertise JudgeExpertise[]
  rankings       RankingResult[]

  @@unique([eventId, name])
  @@map("challenge_tracks")
}

// ─── Room ──────────────────────────────────────────────

enum RoomStatus {
  ACTIVE
  UNAVAILABLE
}

model Room {
  id                   String               @id @default(uuid()) @db.Uuid
  eventId              String               @map("event_id") @db.Uuid
  name                 String
  capacity             Int?
  locationDescription  String?              @map("location_description")
  isVirtual            Boolean              @default(false) @map("is_virtual")
  // Distinct from isVirtual: a physical room that has video conferencing
  // equipment. Teams outside SG present remotely and need one of these.
  hasVideoConferencing Boolean              @default(false) @map("has_video_conferencing")
  status               RoomStatus           @default(ACTIVE)
  unavailability       RoomUnavailability[]
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  deletedAt            DateTime?            @map("deleted_at")

  event    Event            @relation(fields: [eventId], references: [id])
  sessions JudgingSession[]

  @@unique([eventId, name])
  @@map("rooms")
}

// ─── Time Slot ─────────────────────────────────────────

enum SlotType {
  JUDGING
  BREAK
  LUNCH
  CEREMONY
  BLOCKED
  CALIBRATION
}

/// A half-day when a room cannot be used.
///
/// Stored sparsely: a room is available unless a row here says otherwise. That
/// keeps existing events working untouched and means a coordinator records only
/// the exceptions — the opposite default to judge availability, where silence
/// has to mean unavailable because a judge nobody asked about must not be
/// scheduled. A room is a fixed asset; it exists unless someone took it away.
model RoomUnavailability {
  id      String   @id @default(uuid()) @db.Uuid
  roomId  String   @map("room_id") @db.Uuid
  eventId String   @map("event_id") @db.Uuid
  date    DateTime @db.Date
  /// AM or PM. A whole day is two rows, which keeps the query simple.
  session String
  reason  String?

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, date, session])
  @@index([eventId, date])
  @@map("room_unavailability")
}

model TimeSlot {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  date      DateTime @db.Date
  startTime DateTime @map("start_time") @db.Timestamptz
  endTime   DateTime @map("end_time") @db.Timestamptz
  slotType  SlotType @default(JUDGING) @map("slot_type")
  /// Interview events: the half-day block this slot belongs to (e.g. AM) and
  /// its position in the block. Null for wizard events.
  block     String?
  sequence  Int?
  createdAt DateTime @default(now()) @map("created_at")

  event    Event            @relation(fields: [eventId], references: [id])
  sessions JudgingSession[]
  panel    SlotJudge[]

  @@map("time_slots")
}

// ─── Team ──────────────────────────────────────────────

enum TeamStatus {
  DRAFT
  SUBMITTED
  ELIGIBLE
  SCHEDULED
  JUDGED
  COMPLETED
  DISQUALIFIED
}

enum PresentationMode {
  IN_PERSON
  VIRTUAL
}

model Team {
  id               String           @id @default(uuid()) @db.Uuid
  eventId          String           @map("event_id") @db.Uuid
  trackId          String?          @map("track_id") @db.Uuid
  name             String
  projectName      String           @map("project_name")
  useCaseTitle     String?          @map("use_case_title")
  problemStatement String?          @map("problem_statement")
  solutionSummary  String?          @map("solution_summary")
  techStack        String?          @map("tech_stack")
  // The platform this use case was built on, from a fixed list. Distinct from
  // techStack, which is free text and cannot be grouped or matched reliably.
  // Drives vendor matching and platform clustering.
  platform         String?
  department       String?          @map("department")
  useCategory      String?          @map("use_category")
  vendorTools      String?          @map("vendor_tools")
  organisation     String?
  country          String?
  teamLeadName     String           @map("team_lead_name")
  teamLeadEmail    String           @map("team_lead_email")
  presentationMode PresentationMode @default(IN_PERSON) @map("presentation_mode")
  status           TeamStatus       @default(DRAFT)
  eligibilityNotes String?          @map("eligibility_notes")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  deletedAt        DateTime?        @map("deleted_at")

  event      Event                 @relation(fields: [eventId], references: [id])
  track      ChallengeTrack?       @relation(fields: [trackId], references: [id])
  members    TeamMember[]
  conflicts  ConflictDeclaration[]
  sessions   JudgingSession[]
  scorecards Scorecard[]
  rankings   RankingResult[]
  decision   TeamDecision?

  @@unique([eventId, name])
  @@map("teams")
}

model TeamMember {
  id         String   @id @default(uuid()) @db.Uuid
  teamId     String   @map("team_id") @db.Uuid
  name       String
  email      String?
  roleInTeam String?  @map("role_in_team")
  createdAt  DateTime @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id])

  @@map("team_members")
}

// ─── Judge ─────────────────────────────────────────────

enum JudgeTier {
  L1 // Leadership - held back for the final round
  L2 // MD - anchors one room for the whole event
  L3 // ED - rotates between rooms
  L4 // Senior - rotates between rooms
  PS // Professional services - continuous, lunch break only
  V // Vendor - own platform only, additive to the panel
}

enum JudgeType {
  TECHNICAL
  BUSINESS
  DOMAIN
  INNOVATION
  EXECUTIVE
}

enum JudgeStatus {
  ACTIVE
  UNAVAILABLE
  WITHDRAWN
}

model Judge {
  id                   String      @id @default(uuid()) @db.Uuid
  eventId              String      @map("event_id") @db.Uuid
  userId               String?     @map("user_id") @db.Uuid
  name                 String
  email                String
  phone                String?
  organisation         String?
  designation          String?
  judgeType            JudgeType   @map("judge_type")
  judgeTier            JudgeTier   @default(L1) @map("judge_tier")
  maxSessions          Int         @default(10) @map("max_sessions")
  // Has agreed to be interrupted and step in at short notice. Still scheduled
  // normally — this marks availability for a swap, not reserve status.
  isStandby            Boolean     @default(false) @map("is_standby")
  isPanelChairEligible Boolean     @default(false) @map("is_panel_chair_eligible")
  status               JudgeStatus @default(ACTIVE)
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")
  deletedAt            DateTime?   @map("deleted_at")

  event         Event                 @relation(fields: [eventId], references: [id])
  availability  JudgeAvailability[]
  messages      JudgeMessage[]
  expertise     JudgeExpertise[]
  conflicts     ConflictDeclaration[]
  sessionJudges SessionJudge[]
  links         JudgeLink[]
  slotPanels    SlotJudge[]
  scorecards    Scorecard[]

  @@unique([eventId, email])
  @@map("judges")
}

/// A note from a coordinator to a judge, shown in the portal's lower ribbon.
///
/// One active message per judge: sending a new one dismisses the previous,
/// because a judge with a queue of notes will read none of them. Dismissal is
/// the only expiry — a timer would clear something the judge never saw, and an
/// undismissed message is itself worth knowing about.
model JudgeMessage {
  id          String    @id @default(uuid()) @db.Uuid
  judgeId     String    @map("judge_id") @db.Uuid
  eventId     String    @map("event_id") @db.Uuid
  body        String
  /// Who to blame, and who to ask about it.
  sentByName  String    @map("sent_by_name")
  sentAt      DateTime  @default(now()) @map("sent_at")
  dismissedAt DateTime? @map("dismissed_at")

  judge Judge @relation(fields: [judgeId], references: [id], onDelete: Cascade)

  @@index([judgeId, dismissedAt])
  @@map("judge_messages")
}

enum ExpertiseLevel {
  PRIMARY
  SECONDARY
}

model JudgeAvailability {
  id        String   @id @default(uuid()) @db.Uuid
  judgeId   String   @map("judge_id") @db.Uuid
  date      DateTime @db.Date
  startTime DateTime @map("start_time") @db.Timestamptz
  endTime   DateTime @map("end_time") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at")

  judge Judge @relation(fields: [judgeId], references: [id], onDelete: Cascade)

  @@map("judge_availability")
}

model JudgeExpertise {
  id             String         @id @default(uuid()) @db.Uuid
  judgeId        String         @map("judge_id") @db.Uuid
  trackId        String         @map("track_id") @db.Uuid
  expertiseLevel ExpertiseLevel @default(PRIMARY) @map("expertise_level")
  createdAt      DateTime       @default(now()) @map("created_at")

  judge Judge          @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  track ChallengeTrack @relation(fields: [trackId], references: [id])

  @@unique([judgeId, trackId])
  @@map("judge_expertise")
}

// ─── Conflict Declaration ──────────────────────────────

enum ConflictSource {
  SELF_DECLARED
  ADMIN_IMPOSED
}

enum ConflictDeclStatus {
  ACTIVE
  RESOLVED
}

model ConflictDeclaration {
  id           String             @id @default(uuid()) @db.Uuid
  eventId      String             @map("event_id") @db.Uuid
  judgeId      String             @map("judge_id") @db.Uuid
  teamId       String             @map("team_id") @db.Uuid
  reason       String
  source       ConflictSource     @default(ADMIN_IMPOSED)
  status       ConflictDeclStatus @default(ACTIVE)
  declaredById String             @map("declared_by_id") @db.Uuid
  resolvedById String?            @map("resolved_by_id") @db.Uuid
  resolvedAt   DateTime?          @map("resolved_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  event      Event @relation(fields: [eventId], references: [id])
  judge      Judge @relation(fields: [judgeId], references: [id])
  team       Team  @relation(fields: [teamId], references: [id])
  declaredBy User  @relation("declared_by", fields: [declaredById], references: [id])
  resolvedBy User? @relation("resolved_by", fields: [resolvedById], references: [id])

  @@unique([judgeId, teamId, status])
  @@map("conflict_declarations")
}

// ─── Scoring Template ──────────────────────────────────

enum ScoringTemplateStatus {
  DRAFT
  ACTIVE
  LOCKED
}

model ScoringTemplate {
  id          String                @id @default(uuid()) @db.Uuid
  eventId     String                @map("event_id") @db.Uuid
  name        String
  description String?
  maxTotal    Int                   @default(100) @map("max_total")
  status      ScoringTemplateStatus @default(DRAFT)
  /// POINTS: categories of points adding up to maxTotal (hackathon rubric).
  /// RATING: every criterion is rated on the same scale (e.g. 1-5) and the
  /// candidate's score is the average rating.
  scale           String  @default("POINTS")
  /// Asked of every judge as Yes / No when set (e.g. "Support for LAP").
  supportQuestion String? @map("support_question")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  event    Event              @relation(fields: [eventId], references: [id])
  criteria ScoringCriterion[]

  @@map("scoring_templates")
}

model ScoringCriterion {
  // Two-level structure: a criterion with no parent is a category, one with a
  // parent is a scoring row beneath it. Depth is enforced at two in the
  // service — a parent may not itself have a parent.
  parentId String?            @map("parent_id") @db.Uuid
  parent   ScoringCriterion?  @relation("CriterionTree", fields: [parentId], references: [id], onDelete: Cascade)
  children ScoringCriterion[] @relation("CriterionTree")

  id              String   @id @default(uuid()) @db.Uuid
  templateId      String   @map("template_id") @db.Uuid
  name            String
  description     String?
  maxScore        Int      @map("max_score")
  /// Lowest score a judge may give. 0 for points rubrics, 1 for a 1-5 rating.
  minScore        Int      @default(0) @map("min_score")
  weight          Decimal  @default(1.0) @db.Decimal(5, 2)
  displayOrder    Int      @default(0) @map("display_order")
  guidanceText    String?  @map("guidance_text")
  scoringAnchors  Json?    @map("scoring_anchors") @db.JsonB
  requiresComment Boolean  @default(false) @map("requires_comment")
  /// Smallest step a judge may score in: 1 for whole numbers, 0.25 for 3.75.
  scoreIncrement  Decimal  @default(1.0) @map("score_increment") @db.Decimal(4, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  template        ScoringTemplate  @relation(fields: [templateId], references: [id])
  criterionScores CriterionScore[]

  @@map("scoring_criteria")
}

// ─── Audit Log ─────────────────────────────────────────

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  eventId    String?     @map("event_id") @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  action     AuditAction
  entityType String      @map("entity_type")
  entityId   String      @map("entity_id")
  oldValues  Json?       @map("old_values") @db.JsonB
  newValues  Json?       @map("new_values") @db.JsonB
  reason     String?
  createdAt  DateTime    @default(now()) @map("created_at")

  event Event? @relation(fields: [eventId], references: [id])
  user  User   @relation(fields: [userId], references: [id])

  @@index([eventId])
  @@index([entityType, entityId])
  @@index([userId])
  @@map("audit_logs")
}

// ─── Judging Session ───────────────────────────────────

enum SessionStage {
  SCHEDULED
  TEAM_CHECKED_IN
  JUDGES_PRESENT
  READY
  IN_PROGRESS
  QA
  SCORING
  COMPLETED
  DELAYED
  AT_RISK
  RESCHEDULED
  CANCELLED
  NO_SHOW
}

model JudgingSession {
  id             String       @id @default(uuid()) @db.Uuid
  eventId        String       @map("event_id") @db.Uuid
  teamId         String       @map("team_id") @db.Uuid
  roomId         String       @map("room_id") @db.Uuid
  timeSlotId     String       @map("time_slot_id") @db.Uuid
  roundId        String?      @map("round_id") @db.Uuid
  stage          SessionStage @default(SCHEDULED)
  scheduledStart DateTime?    @map("scheduled_start") @db.Timestamptz
  scheduledEnd   DateTime?    @map("scheduled_end") @db.Timestamptz
  actualStart    DateTime?    @map("actual_start") @db.Timestamptz
  actualEnd      DateTime?    @map("actual_end") @db.Timestamptz
  delayMinutes   Int          @default(0) @map("delay_minutes")
  delayReason    String?      @map("delay_reason")
  notes          String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  event      Event           @relation(fields: [eventId], references: [id])
  team       Team            @relation(fields: [teamId], references: [id])
  room       Room            @relation(fields: [roomId], references: [id])
  timeSlot   TimeSlot        @relation(fields: [timeSlotId], references: [id])
  round      JudgingRound?   @relation(fields: [roundId], references: [id])
  judges     SessionJudge[]
  scorecards Scorecard[]
  rankings   RankingResult[]
  links      JudgeLink[]
  decisions  TeamDecision[]

  @@map("judging_sessions")
}

model SessionJudge {
  id            String    @id @default(uuid()) @db.Uuid
  sessionId     String    @map("session_id") @db.Uuid
  judgeId       String    @map("judge_id") @db.Uuid
  attended      Boolean   @default(false)
  /// The judge has stepped out of this session.
  ///
  /// Distinct from `attended`, which records whether they turned up. A break is
  /// declared by the judge for one session and reversed when they return; it is
  /// not a statement about the whole day.
  onBreak       Boolean   @default(false) @map("on_break")
  breakAt       DateTime? @map("break_at")
  /// Set when the organizing team takes an absent judge off the panel. A
  /// removed judge's scorecard no longer counts towards the team being ready.
  removedAt     DateTime? @map("removed_at")
  removedReason String?   @map("removed_reason")
  createdAt     DateTime  @default(now()) @map("created_at")

  session JudgingSession @relation(fields: [sessionId], references: [id])
  judge   Judge          @relation(fields: [judgeId], references: [id])

  @@unique([sessionId, judgeId])
  @@map("session_judges")
}

// ─── Scorecard ─────────────────────────────────────────

enum ScorecardStatus {
  NOT_STARTED
  DRAFT
  SUBMITTED
  REOPENED
  RESUBMITTED
  LOCKED
}

model Scorecard {
  id                  String          @id @default(uuid()) @db.Uuid
  sessionId           String          @map("session_id") @db.Uuid
  judgeId             String          @map("judge_id") @db.Uuid
  teamId              String          @map("team_id") @db.Uuid
  eventId             String          @map("event_id") @db.Uuid
  status              ScorecardStatus @default(NOT_STARTED)
  totalScore          Float?          @map("total_score")
  /// Encrypted copy of totalScore (see src/crypto/encrypted-fields.ts).
  totalScoreEnc       String?         @map("total_score_enc")
  overallStrengths    String?         @map("overall_strengths")
  areasForImprovement String?         @map("areas_for_improvement")
  recommendation      String?
  /// The judge's Yes / No to the rubric's support question, when it has one.
  support             Boolean?
  /// Encrypted copy of support.
  supportEnc          String?         @map("support_enc")
  conflictConfirmed   Boolean         @default(false) @map("conflict_confirmed")
  submittedAt         DateTime?       @map("submitted_at")
  lockedAt            DateTime?       @map("locked_at")
  reopenReason        String?         @map("reopen_reason")
  // A judge marking a team for a second look. Without somewhere to put that
  // thought they either submit a score they are unsure of, or try to remember.
  flaggedForReview    Boolean         @default(false) @map("flagged_for_review")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  session         JudgingSession   @relation(fields: [sessionId], references: [id])
  judge           Judge            @relation(fields: [judgeId], references: [id])
  team            Team             @relation(fields: [teamId], references: [id])
  criterionScores CriterionScore[]

  @@unique([sessionId, judgeId])
  @@map("scorecards")
}

model CriterionScore {
  id          String   @id @default(uuid()) @db.Uuid
  scorecardId String   @map("scorecard_id") @db.Uuid
  criterionId String   @map("criterion_id") @db.Uuid
  /// Whole numbers for points rubrics; steps such as 3.75 for ratings.
  score       Float?
  /// Encrypted copy of score (see src/crypto/encrypted-fields.ts).
  scoreEnc    String?  @map("score_enc")
  comment     String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  scorecard Scorecard        @relation(fields: [scorecardId], references: [id])
  criterion ScoringCriterion @relation(fields: [criterionId], references: [id])

  @@unique([scorecardId, criterionId])
  @@map("criterion_scores")
}

// ─── Rankings ──────────────────────────────────────────

enum RankingStatus {
  CALCULATING
  PROVISIONAL
  APPROVED
  PUBLISHED
}

model RankingResult {
  id                String        @id @default(uuid()) @db.Uuid
  eventId           String        @map("event_id") @db.Uuid
  trackId           String?       @map("track_id") @db.Uuid
  teamId            String        @map("team_id") @db.Uuid
  rankPosition      Int           @map("rank_position")
  aggregatedScore   Decimal       @map("aggregated_score") @db.Decimal(6, 2)
  judgeCount        Int           @map("judge_count")
  tied              Boolean       @default(false)
  aggregationMethod String        @default("criterion_average_sum") @map("aggregation_method")
  status            RankingStatus @default(CALCULATING)
  approvedBy        String?       @map("approved_by") @db.Uuid
  approvedAt        DateTime?     @map("approved_at")
  publishedAt       DateTime?     @map("published_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  event            Event           @relation(fields: [eventId], references: [id])
  track            ChallengeTrack? @relation(fields: [trackId], references: [id])
  team             Team            @relation(fields: [teamId], references: [id])
  JudgingSession   JudgingSession? @relation(fields: [judgingSessionId], references: [id])
  judgingSessionId String?         @db.Uuid

  @@unique([eventId, trackId, teamId])
  @@map("ranking_results")
}

model JudgingRound {
  id                String      @id @default(uuid()) @db.Uuid
  eventId           String      @map("event_id") @db.Uuid
  name              String
  roundNumber       Int         @map("round_number")
  status            RoundStatus @default(PENDING)
  allowedTiers      String[]    @map("allowed_tiers")
  teamCount         Int?        @map("team_count")
  advanceCount      Int?        @map("advance_count")
  scoringTemplateId String?     @map("scoring_template_id") @db.Uuid
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  event    Event            @relation(fields: [eventId], references: [id])
  sessions JudgingSession[]

  @@map("judging_rounds")
}

enum RoundStatus {
  PENDING
  SCHEDULING
  SCHEDULED
  IN_PROGRESS
  SCORING
  CALCULATING
  COMPLETED
}

model EventUser {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  eventId   String    @map("event_id") @db.Uuid
  role      EventRole
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id])
  event     Event     @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId])
  @@map("event_users")
}

// ─── Day-based judging (events set up by Excel upload) ──

enum EventSetupMode {
  WIZARD
  UPLOAD
}

enum JudgingDayStatus {
  OPEN
  CLOSED
}

/// One row per judging date of an event. Closing the day revokes its judge
/// links and locks its scorecards; a closed day is never reopened.
model JudgingDay {
  id               String           @id @default(uuid()) @db.Uuid
  eventId          String           @map("event_id") @db.Uuid
  date             DateTime         @db.Date
  status           JudgingDayStatus @default(OPEN)
  closedById       String?          @map("closed_by") @db.Uuid
  closedAt         DateTime?        @map("closed_at")
  /// Once set, the day's judge panels are fixed: a new availability upload
  /// leaves this day alone. Panels can still be edited by hand.
  panelsLockedAt   DateTime?        @map("panels_locked_at")
  panelsLockedById String?          @map("panels_locked_by") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  event          Event       @relation(fields: [eventId], references: [id])
  closedBy       User?       @relation("day_closed_by", fields: [closedById], references: [id])
  panelsLockedBy User?       @relation("day_panels_locked_by", fields: [panelsLockedById], references: [id])
  links          JudgeLink[]

  @@unique([eventId, date])
  @@map("judging_days")
}

enum JudgeLinkScope {
  DAY
  SESSION
}

/// A judge's link, stored so it can be revoked. A DAY link lets the judge
/// score their sessions on that day; a SESSION link (issued when the admin
/// reopens a session) lets them score that one session. Either way the judge
/// can view their whole schedule read-only.
model JudgeLink {
  id            String         @id @default(uuid()) @db.Uuid
  token         String         @unique
  eventId       String         @map("event_id") @db.Uuid
  judgeId       String         @map("judge_id") @db.Uuid
  scope         JudgeLinkScope
  dayId         String?        @map("day_id") @db.Uuid
  sessionId     String?        @map("session_id") @db.Uuid
  createdById   String?        @map("created_by") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at")
  lastUsedAt    DateTime?      @map("last_used_at")
  revokedAt     DateTime?      @map("revoked_at")
  revokedReason String?        @map("revoked_reason")

  event     Event           @relation(fields: [eventId], references: [id])
  judge     Judge           @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  day       JudgingDay?     @relation(fields: [dayId], references: [id])
  session   JudgingSession? @relation(fields: [sessionId], references: [id])
  createdBy User?           @relation("link_created_by", fields: [createdById], references: [id])

  @@index([judgeId])
  @@index([dayId])
  @@index([sessionId])
  @@map("judge_links")
}

enum TeamDecisionValue {
  SELECTED
  WAITLIST
  NOT_SELECTED
  /// The candidate did not turn up. Needs no scores; closes the record.
  DID_NOT_ATTEND
}

enum TeamDecisionStatus {
  DRAFT
  SUBMITTED
}

/// The admin's closure of a team's record: feedback and a decision. Each team
/// is judged once, so there is one row per team. Reopening the team's session
/// moves it back to DRAFT and bumps the revision; earlier versions live in the
/// audit log.
model TeamDecision {
  id          String             @id @default(uuid()) @db.Uuid
  eventId     String             @map("event_id") @db.Uuid
  teamId      String             @unique @map("team_id") @db.Uuid
  sessionId   String             @map("session_id") @db.Uuid
  decision    TeamDecisionValue?
  feedback    String?
  status      TeamDecisionStatus @default(DRAFT)
  revision    Int                @default(1)
  decidedById String?            @map("decided_by") @db.Uuid
  decidedAt   DateTime?          @map("decided_at")
  /// Set when a scoring is reopened after the decision: the decision goes
  /// back to DRAFT, the revision goes up, and the earlier report is kept
  /// marked superseded.
  reopenedAt   DateTime?         @map("reopened_at")
  reopenedById String?           @map("reopened_by") @db.Uuid
  reopenReason String?           @map("reopen_reason")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  event     Event          @relation(fields: [eventId], references: [id])
  team      Team           @relation(fields: [teamId], references: [id])
  session   JudgingSession @relation(fields: [sessionId], references: [id])
  decidedBy User?          @relation("decided_by", fields: [decidedById], references: [id])
  reports   DecisionReport[]

  @@index([eventId])
  @@index([sessionId])
  @@map("team_decisions")
}

/// The candidate's assessment report as a PDF, made when HR submits the final
/// decision and kept as it was then. A record reopened and decided again gets
/// a new revision; earlier ones are kept.
model DecisionReport {
  id         String   @id @default(uuid()) @db.Uuid
  eventId    String   @map("event_id") @db.Uuid
  decisionId String   @map("decision_id") @db.Uuid
  teamId     String   @map("team_id") @db.Uuid
  revision   Int
  fileName   String   @map("file_name")
  pdf        Bytes
  createdAt  DateTime @default(now()) @map("created_at")
  /// Set when the record is reopened: a later revision replaces this one.
  supersededAt     DateTime? @map("superseded_at")
  supersededReason String?   @map("superseded_reason")

  decision TeamDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@unique([decisionId, revision])
  @@index([eventId])
  @@map("decision_reports")
}

/// The panel for one interview slot (interview events). Built from judges'
/// availability: a judge sits a slot when their window covers it entirely.
/// A candidate's session copies its slot's panel when the candidate is placed.
model SlotJudge {
  id         String   @id @default(uuid()) @db.Uuid
  timeSlotId String   @map("time_slot_id") @db.Uuid
  judgeId    String   @map("judge_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  timeSlot TimeSlot @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)
  judge    Judge    @relation(fields: [judgeId], references: [id], onDelete: Cascade)

  @@unique([timeSlotId, judgeId])
  @@index([judgeId])
  @@map("slot_judges")
}

/// The field-encryption data key(s), each encrypted by the AWS KMS key.
/// Never delete: without these rows the encrypted data cannot be read.
model DataKey {
  id           Int      @id @default(autoincrement())
  version      Int      @unique
  kmsKeyId     String   @map("kms_key_id")
  encryptedKey Bytes    @map("encrypted_key")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("data_keys")
}
