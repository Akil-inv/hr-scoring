# @nestjs/apollo 13 pins @apollo/server-plugin-landing-page-graphql-playground
# 4.0.1, whose peer range stops at Apollo Server 4, so a strict install
# refuses Apollo Server 5 although nothing loads that plugin (the app uses
# GraphiQL). The Dockerfile already installs with --legacy-peer-deps; this
# makes local installs, CI and patch-kit do the same.
legacy-peer-deps=true
