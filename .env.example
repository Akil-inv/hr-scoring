# Copy to .env on the server and fill in every value. .env is never committed.

# Database password for this stack's own Postgres. Any long random string:
#   openssl rand -hex 24
DB_PASSWORD=

# Signs admin login tokens. Any long random string:
#   openssl rand -hex 32
JWT_SECRET=

# Used for links on events set up through the wizard. Set once, never change
# during an event (changing it invalidates links already sent).
#   openssl rand -hex 16
JUDGE_TOKEN_SALT=

# Tailscale auth key from https://login.tailscale.com/admin/settings/keys
# Only needed for the first start; the node stays signed in afterwards.
TS_AUTHKEY=

# Machine name on the tailnet. The app is then at
#   https://<TS_HOSTNAME>.<your-tailnet>.ts.net
TS_HOSTNAME=hr-scoring

# The full https address above, once you know it. Restricts which site may
# call the API with a login. Leave blank on the first start.
PUBLIC_ORIGIN=

# Encrypts candidate data at rest (names, contacts, comments, scores, PDFs).
# The AWS KMS key alias or ARN, e.g. alias/hr-scoring, set up by
# tools/encryption/setup-aws-kms.sh. Guide: docs/FIELD-ENCRYPTION.md
KMS_KEY_ID=

# Leave unset. Only for break glass (./encryption.sh break-glass sets it) or
# installs without AWS KMS: the recovery key itself.
# FIELD_ENCRYPTION_KEY=

# Email for sign-in links: invites, password resets, email changes. Optional.
# Leave SMTP_HOST empty and admins copy links from the Users page instead.
# Works with any SMTP server: a company relay, Amazon SES (SMTP), Microsoft
# 365, Google Workspace. Restart the api after changing (docker-compose up -d api).
# APP_URL=http://100.119.28.22       # the address people open the app at; goes in the links
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587                      # 465 with SMTP_SECURE=true; 25 for an internal relay
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=HR Scoring <no-reply@example.com>
# MAIL_REPLY_TO=
# SMTP_REJECT_UNAUTHORIZED=true      # false only for an internal relay with its own certificate
