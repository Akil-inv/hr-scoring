# Copy to .env on the server and fill in every value. .env is never committed.

# Database password for this stack's own Postgres. Any long random string:
#   openssl rand -hex 24
DB_PASSWORD=

# Signs admin login tokens. Any long random string:
#   openssl rand -hex 32
JWT_SECRET=

# Used for links on events set up through the wizard. Set once, never change
# during an event (changing it invalidates links already sent).
#   openssl rand -hex 16
JUDGE_TOKEN_SALT=

# Tailscale auth key from https://login.tailscale.com/admin/settings/keys
# Only needed for the first start; the node stays signed in afterwards.
TS_AUTHKEY=

# Machine name on the tailnet. The app is then at
#   https://<TS_HOSTNAME>.<your-tailnet>.ts.net
TS_HOSTNAME=hr-scoring

# The full https address above, once you know it. Restricts which site may
# call the API with a login. Leave blank on the first start.
PUBLIC_ORIGIN=
